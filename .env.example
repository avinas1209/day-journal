APP_NAME=day-journal
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=info

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

POSTGRES_DSN=postgres://postgres:root@localhost:5432/day-journal?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_CONN_LIFETIME=1h
POSTGRES_CONNECT_TIMEOUT=10s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=day-journal
REDIS_CACHE_TTL=10m
REDIS_CONNECT_TIMEOUT=5s

NATS_URL=nats://localhost:4222
NATS_STREAM=DAY_JOURNAL
NATS_SUBJECT_PREFIX=day-journal
NATS_CONNECT_TIMEOUT=5s

# --- Auth ---
# Required outside development: at least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# During a rotation, the old secret goes here so existing tokens keep verifying.
JWT_PREVIOUS_SECRETS=
JWT_ISSUER=day-journal
JWT_AUDIENCE=day-journal-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12
# Comma-separated OAuth client ids whose Google ID tokens are accepted
# (the iOS client id at minimum). Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=

# --- HTTP hardening ---
# Load balancers allowed to set X-Forwarded-For. Empty = trust none, which is
# right when clients connect directly.
HTTP_TRUSTED_PROXIES=
HTTP_MAX_BODY_BYTES=1048576
